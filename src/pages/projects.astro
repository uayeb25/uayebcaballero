---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import ProjectCard from '../components/ProjectCard.astro';

interface Project {
  slug: string;
  data: {
    title: string;
    description: string;
    title_en: string;
    description_en: string;
    icon: string;
  };
}

const projects: Project[] = await getCollection('projects');
---

<Layout title="Projects - Uayeb Caballero">
  <div class="max-w-4xl mx-auto mt-8">

    <h1 class="text-4xl font-bold text-orange-800 mb-6" data-lang="en" >Projects</h1>
    <h1 class="text-4xl font-bold text-orange-800 mb-6" data-lang="es" >Proyectos</h1>

    <div class="grid gap-6 md:grid-cols-2">

      {projects.map((project) => (
        <ProjectCard
          title={project.data.title}
          description={project.data.description}
          icon={project.data.icon}
          href={`/projects/${project.slug}`}
          lang="es"
        />
      ))}

      {projects.map((project) => (
        <ProjectCard
          title={project.data.title_en}
          description={project.data.description_en}
          icon={project.data.icon}
          href={`/projects/${project.slug}`}
          lang="en"
        />
      ))}

    </div>
  </div>
</Layout>