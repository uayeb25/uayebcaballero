---
import Layout from '../layouts/Layout.astro';

import CardIndex from '../components/CardIndex.astro';
import Social from '../components/Social.astro';
import SkillCategory from '../components/SkillCategory.astro';

import { Image } from 'astro:assets';

import { socials, cards, skills } from '../content/data/db'
---

<Layout 
  title="Uayeb Caballero - IT Professional & EdTech Specialist"
  description="Conoce a Uayeb Caballero, profesional IT y especialista en EdTech, con experiencia en desarrollo, gestión de proyectos y herramientas educativas digitales."
>
  <div class="max-w-3xl mx-auto">
    <div class="text-center mb-12">
      <Image
        src="/images/uayeb.jpeg"
        alt="Uayeb Caballero"
        width={200}
        height={200}
        class="rounded-full border-4 border-orange-500 mx-auto mb-6"
      />
      <h1 class="text-4xl font-bold text-orange-800 mb-2">Uayeb Caballero</h1>
      <p class="text-xl text-gray-600">IT Professional & EdTech Specialist</p>
    </div>

    <div class="space-y-8">

      {
        cards.map((card, index) => (
          <CardIndex
            title={card.title}
            title_en={card.title_en}
            description={card.description}
            description_en={card.description_en}
          />
        ))
      }

      <SkillCategory 
        name="Habilidades"
        name_en="Skills"
        skills={skills}
      />

    </div>

    <div class="mt-12 flex justify-center space-x-6">
      {
        socials.map((social, index) => (
          <Social
            name={social.name}
            url={social.url}
            icon={social.icon}
          />
        ))
      }
    </div>

  </div>
  <astro:head>
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Uayeb Caballero",
        "jobTitle": "IT Professional & EdTech Specialist",
        "description": "Profesionista en tecnología y especialista en herramientas educativas...",
        "image": "https://uayebcaballero.dev/images/uayeb.jpeg",
        "url": "https://uayebcaballero.dev/"
      }
    </script>
  </astro:head>
</Layout>

