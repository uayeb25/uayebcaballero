---
import { navItems } from '../content/data/db';
---

<aside class="bg-orange-800 text-white w-64 min-h-screen p-4">
  <nav>
    <ul class="space-y-2">
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class="block py-2 px-4 rounded transition-colors hover:bg-orange-700"
          >
            <span data-lang="es">{item.titleEs}</span>
            <span data-lang="en" class="hidden">{item.titleEn}</span>
          </a>
          {item.subitems && (
            <ul class="ml-4 mt-2 space-y-1">
              {item.subitems.map((subitem) => (
                <li>
                  <a
                    href={subitem.href}
                    class="block py-1 px-4 rounded text-sm transition-colors hover:bg-orange-700"
                  >
                    <span data-lang="es">{subitem.titleEs}</span>
                    <span data-lang="en" class="hidden">{subitem.titleEn}</span>
                  </a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
  </nav>
</aside>